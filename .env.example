# Clé API Anthropic : analyse de la transcription (idées, décisions, actions...).
# Sans clé, un extracteur local par mots-clés est utilisé (moins précis).
ANTHROPIC_API_KEY=

# Transcription côté serveur (audio de la réunion = son de l'ordinateur + micro).
# Tout endpoint compatible "audio/transcriptions" (Whisper) : OpenAI, Groq,
# ou un serveur local (faster-whisper-server, whisper.cpp server...).
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=fr

# 0.0.0.0 : joignable par l'app Android (protégé par la clé du QR code).
# 127.0.0.1 : accessible uniquement depuis ce PC (app mobile désactivée).
HOST=0.0.0.0
PORT=3000
